  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^22.19.19",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.0.1",
    "sharp": "^0.34.5",
    "svelte": "5.55.9",
    "svelte-check": "4.4.8",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.7",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
