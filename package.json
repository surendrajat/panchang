    "prettier-plugin-svelte": "3.3.3",
    "sharp": "^0.34.5",
    "svelte": "5.16.6",
    "svelte-check": "4.1.4",
    "tsx": "^4.22.3",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8",
    "workbox-window": "7.3.0"
