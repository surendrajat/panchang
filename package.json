{
  "name": "panchanga",
  "version": "0.1.0",
  "description": "Offline Hindu calendar (panchanga) and Vedic birth charts (kundli) — tithi, nakshatra, yoga, karana, festivals.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && eslint .",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\""
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "dexie": "4.4.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.13.2",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.19.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.9",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "volta": {
    "node": "24.16.0"
  }
}
